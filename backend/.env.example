# Defaults work without copying this file.
HOST=127.0.0.1
PORT=3000
# Optional public HTTPS origin. Setting this serves frontend/dist and Socket.IO
# from the same backend port. Run npm run build before starting the backend.
PUBLIC_APP_URL=

# Voice is optional for local development. Use a LiveKit Cloud project URL
# (wss://...) and its server-side API credentials for public access.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

