    "start": "node --env-file-if-exists=.env dist/index.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@mewting/shared": "0.1.0",
    "fastify": "5.12.8",
    "livekit-server-sdk": "2.19.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  }
}
